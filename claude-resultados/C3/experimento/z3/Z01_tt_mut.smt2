; tabela-verdade de: A and (B or C)
; entradas (átomos distintos): p0 = A; p1 = B; p2 = C
(declare-const p0 Bool)
(declare-const p1 Bool)
(declare-const p2 Bool)
(push)(assert (and (= p0 true) (= p1 true) (= p2 true) (and p0 (or p1 p2))))(check-sat)(pop)
(push)(assert (and (= p0 true) (= p1 true) (= p2 false) (and p0 (or p1 p2))))(check-sat)(pop)
(push)(assert (and (= p0 true) (= p1 false) (= p2 true) (and p0 (or p1 p2))))(check-sat)(pop)
(push)(assert (and (= p0 true) (= p1 false) (= p2 false) (and p0 (or p1 p2))))(check-sat)(pop)
(push)(assert (and (= p0 false) (= p1 true) (= p2 true) (and p0 (or p1 p2))))(check-sat)(pop)
(push)(assert (and (= p0 false) (= p1 true) (= p2 false) (and p0 (or p1 p2))))(check-sat)(pop)
(push)(assert (and (= p0 false) (= p1 false) (= p2 true) (and p0 (or p1 p2))))(check-sat)(pop)
(push)(assert (and (= p0 false) (= p1 false) (= p2 false) (and p0 (or p1 p2))))(check-sat)(pop)
