; Q-E1-par-A: par mascaramento de A
(declare-const t1_A Bool)
(declare-const t1_B Bool)
(declare-const t1_C Bool)
(declare-const t2_A Bool)
(declare-const t2_B Bool)
(declare-const t2_C Bool)
(assert (and (distinct t1_A t2_A) (distinct (or (and t1_A t1_B) t1_C) (or (and t2_A t2_B) t2_C)) (distinct (or (and t1_A t1_B) t1_C) (or (and (not t1_A) t1_B) t1_C)) (distinct (or (and t2_A t2_B) t2_C) (or (and (not t2_A) t2_B) t2_C))))
(check-sat)
(get-model)
