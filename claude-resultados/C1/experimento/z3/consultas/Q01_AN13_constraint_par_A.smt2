; A or (B and C) --constraint 'not A or B'
; condição alvo: A
(declare-const A_1 Bool)
(declare-const B_1 Bool)
(declare-const C_1 Bool)
(declare-const A_2 Bool)
(declare-const B_2 Bool)
(declare-const C_2 Bool)
(assert (= B_1 B_2))
(assert (= C_1 C_2))
(assert (not (= A_1 A_2)))
(assert (or (not A_1) B_1))
(assert (or (not A_2) B_2))
(assert (not (= (or A_1 (and B_1 C_1)) (or A_2 (and B_2 C_2)))))
(check-sat)
(get-model)
