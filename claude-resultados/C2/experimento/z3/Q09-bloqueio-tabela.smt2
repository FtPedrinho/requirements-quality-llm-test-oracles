; consulta Q09-bloqueio-tabela -- A22: combinações impossíveis
(set-logic ALL)
(declare-const x Int)
(push)
(assert (> x 5))
(assert (> x 3))
(check-sat)
(pop)
(push)
(assert (> x 5))
(assert (not (> x 3)))
(check-sat)
(pop)
(push)
(assert (not (> x 5)))
(assert (> x 3))
(check-sat)
(pop)
(push)
(assert (not (> x 5)))
(assert (not (> x 3)))
(check-sat)
(pop)
