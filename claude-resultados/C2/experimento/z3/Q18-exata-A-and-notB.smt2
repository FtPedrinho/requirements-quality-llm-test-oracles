; consulta Q18-exata-A-and-notB -- A03 (referência)
(set-logic ALL)
(define-fun f ((b0 Bool) (b1 Bool)) Bool (and b0 (not b1)))
(declare-const s0 Bool)
(declare-const s1 Bool)
(declare-const s2 Bool)
(declare-const s3 Bool)
(assert (or (and s0 s2 (distinct (f true true) (f false true))) (and s1 s3 (distinct (f true false) (f false false)))))
(assert (or (and s0 s1 (distinct (f true true) (f true false))) (and s2 s3 (distinct (f false true) (f false false)))))
(push)
(assert (<= (+ (ite s0 1 0) (ite s1 1 0) (ite s2 1 0) (ite s3 1 0)) 1))
(check-sat)
(pop)
(push)
(assert (<= (+ (ite s0 1 0) (ite s1 1 0) (ite s2 1 0) (ite s3 1 0)) 2))
(check-sat)
(pop)
(push)
(assert (<= (+ (ite s0 1 0) (ite s1 1 0) (ite s2 1 0) (ite s3 1 0)) 3))
(check-sat)
(pop)
(push)
(assert (<= (+ (ite s0 1 0) (ite s1 1 0) (ite s2 1 0) (ite s3 1 0)) 4))
(check-sat)
(pop)
