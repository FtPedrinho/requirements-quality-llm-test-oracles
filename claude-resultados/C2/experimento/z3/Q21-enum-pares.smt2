; consulta Q21-enum-pares -- J15
(set-logic ALL)
(declare-datatypes () ((E_m m__a m__b m__c)))
(declare-const m_1 E_m)
(declare-const m_2 E_m)
(push)
(assert (= m_1 m__a))
(assert (not (= m_2 m__a)))
(assert (= (= m_1 m__b) (= m_2 m__b)))
(assert (distinct (or (= m_1 m__a) (= m_1 m__b)) (or (= m_2 m__a) (= m_2 m__b))))
(check-sat)
(pop)
(push)
(assert (= m_1 m__b))
(assert (not (= m_2 m__b)))
(assert (= (= m_1 m__a) (= m_2 m__a)))
(assert (distinct (or (= m_1 m__a) (= m_1 m__b)) (or (= m_2 m__a) (= m_2 m__b))))
(check-sat)
(pop)
