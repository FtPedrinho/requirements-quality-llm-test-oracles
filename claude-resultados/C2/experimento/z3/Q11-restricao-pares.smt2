; consulta Q11-restricao-pares -- A24: pares respeitando a restrição not A or B
(set-logic ALL)
(declare-const b0_1 Bool)
(declare-const b1_1 Bool)
(declare-const b2_1 Bool)
(declare-const b0_2 Bool)
(declare-const b1_2 Bool)
(declare-const b2_2 Bool)
(push)
(assert b0_1)
(assert (not b0_2))
(assert (= b1_1 b1_2))
(assert (= b2_1 b2_2))
(assert (distinct (or b0_1 (and b1_1 b2_1)) (or b0_2 (and b1_2 b2_2))))
(assert (or (not b0_1) b1_1))
(assert (or (not b0_2) b1_2))
(check-sat)
(pop)
(push)
(assert b1_1)
(assert (not b1_2))
(assert (= b0_1 b0_2))
(assert (= b2_1 b2_2))
(assert (distinct (or b0_1 (and b1_1 b2_1)) (or b0_2 (and b1_2 b2_2))))
(assert (or (not b0_1) b1_1))
(assert (or (not b0_2) b1_2))
(check-sat)
(pop)
(push)
(assert b2_1)
(assert (not b2_2))
(assert (= b0_1 b0_2))
(assert (= b1_1 b1_2))
(assert (distinct (or b0_1 (and b1_1 b2_1)) (or b0_2 (and b1_2 b2_2))))
(assert (or (not b0_1) b1_1))
(assert (or (not b0_2) b1_2))
(check-sat)
(pop)
