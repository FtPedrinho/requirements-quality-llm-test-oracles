; consulta Q04-eq-ne-pares -- A07
(set-logic ALL)
(declare-const x_1 Int)
(declare-const y_1 Int)
(declare-const x_2 Int)
(declare-const y_2 Int)
(push)
(assert (= x_1 5))
(assert (not (= x_2 5)))
(assert (= (not (= y_1 3)) (not (= y_2 3))))
(assert (distinct (and (= x_1 5) (not (= y_1 3))) (and (= x_2 5) (not (= y_2 3)))))
(check-sat)
(pop)
(push)
(assert (not (= y_1 3)))
(assert (not (not (= y_2 3))))
(assert (= (= x_1 5) (= x_2 5)))
(assert (distinct (and (= x_1 5) (not (= y_1 3))) (and (= x_2 5) (not (= y_2 3)))))
(check-sat)
(pop)
