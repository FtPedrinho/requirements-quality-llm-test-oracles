; consulta Q14-fronteira-gt50 -- A28: menor valor que satisfaz e maior que não satisfaz speed > 50 (inteiros)
(set-logic ALL)
(declare-const x Int)
(declare-const y Int)
(push)
(assert (> x 50))
(assert (not (> (- x 1) 50)))
(check-sat)
(get-value (x))
(assert (distinct x 51))
(check-sat)
(pop)
(push)
(assert (not (> y 50)))
(assert (> (+ y 1) 50))
(check-sat)
(get-value (y))
(assert (distinct y 50))
(check-sat)
(pop)
