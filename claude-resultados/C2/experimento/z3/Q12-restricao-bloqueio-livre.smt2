; consulta Q12-restricao-bloqueio-livre -- A25: sem restrição
(set-logic ALL)
(declare-const b0_1 Bool)
(declare-const b1_1 Bool)
(declare-const b0_2 Bool)
(declare-const b1_2 Bool)
(push)
(assert b0_1)
(assert (not b0_2))
(assert (= b1_1 b1_2))
(assert (distinct (and b0_1 b1_1) (and b0_2 b1_2)))
(check-sat)
(pop)
(push)
(assert b1_1)
(assert (not b1_2))
(assert (= b0_1 b0_2))
(assert (distinct (and b0_1 b1_1) (and b0_2 b1_2)))
(check-sat)
(pop)
