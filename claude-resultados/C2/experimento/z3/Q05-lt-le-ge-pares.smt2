; consulta Q05-lt-le-ge-pares -- A08
(set-logic ALL)
(declare-const a_1 Int)
(declare-const b_1 Int)
(declare-const c_1 Int)
(declare-const a_2 Int)
(declare-const b_2 Int)
(declare-const c_2 Int)
(push)
(assert (< a_1 1))
(assert (not (< a_2 1)))
(assert (= (<= b_1 2) (<= b_2 2)))
(assert (= (>= c_1 3) (>= c_2 3)))
(assert (distinct (or (< a_1 1) (and (<= b_1 2) (>= c_1 3))) (or (< a_2 1) (and (<= b_2 2) (>= c_2 3)))))
(check-sat)
(pop)
(push)
(assert (<= b_1 2))
(assert (not (<= b_2 2)))
(assert (= (< a_1 1) (< a_2 1)))
(assert (= (>= c_1 3) (>= c_2 3)))
(assert (distinct (or (< a_1 1) (and (<= b_1 2) (>= c_1 3))) (or (< a_2 1) (and (<= b_2 2) (>= c_2 3)))))
(check-sat)
(pop)
(push)
(assert (>= c_1 3))
(assert (not (>= c_2 3)))
(assert (= (< a_1 1) (< a_2 1)))
(assert (= (<= b_1 2) (<= b_2 2)))
(assert (distinct (or (< a_1 1) (and (<= b_1 2) (>= c_1 3))) (or (< a_2 1) (and (<= b_2 2) (>= c_2 3)))))
(check-sat)
(pop)
