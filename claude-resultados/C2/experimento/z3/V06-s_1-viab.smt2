; consulta V06-s_1-viab -- viabilidade das combinações de s#1
(set-logic ALL)
(declare-datatypes () ((E_mode mode__idle mode__busy)))
(declare-const mode E_mode)
(declare-const s Bool)
(push)
(assert (= mode mode__idle))
(assert (= s true))
(check-sat)
(pop)
(push)
(assert (= mode mode__idle))
(assert (not (= s true)))
(check-sat)
(pop)
(push)
(assert (not (= mode mode__idle)))
(assert (= s true))
(check-sat)
(pop)
(push)
(assert (not (= mode mode__idle)))
(assert (not (= s true)))
(check-sat)
(pop)
