; consulta NPP-npp_7-pares -- par de causa única viável por entrada de npp#7
(set-logic ALL)
(declare-datatypes () ((E_the_pressure_mode the_pressure_mode__low the_pressure_mode__permitted the_pressure_mode__high)))
(declare-datatypes () ((E_the_pressure_mode_antes the_pressure_mode_antes__low the_pressure_mode_antes__permitted the_pressure_mode_antes__high)))
(declare-datatypes () ((E_the_blockage_button the_blockage_button__released the_blockage_button__pressed)))
(declare-datatypes () ((E_the_blockage_button_antes the_blockage_button_antes__released the_blockage_button_antes__pressed)))
(declare-datatypes () ((E_the_reset_button the_reset_button__released the_reset_button__pressed)))
(declare-datatypes () ((E_the_reset_button_antes the_reset_button_antes__released the_reset_button_antes__pressed)))
(declare-const the_water_pressure_1 Int)
(declare-const the_water_pressure_antes_1 Int)
(declare-const the_pressure_mode_1 E_the_pressure_mode)
(declare-const the_pressure_mode_antes_1 E_the_pressure_mode_antes)
(declare-const the_blockage_button_1 E_the_blockage_button)
(declare-const the_blockage_button_antes_1 E_the_blockage_button_antes)
(declare-const the_reset_button_1 E_the_reset_button)
(declare-const the_reset_button_antes_1 E_the_reset_button_antes)
(declare-const the_overridden_mode_1 Bool)
(declare-const the_water_pressure_2 Int)
(declare-const the_water_pressure_antes_2 Int)
(declare-const the_pressure_mode_2 E_the_pressure_mode)
(declare-const the_pressure_mode_antes_2 E_the_pressure_mode_antes)
(declare-const the_blockage_button_2 E_the_blockage_button)
(declare-const the_blockage_button_antes_2 E_the_blockage_button_antes)
(declare-const the_reset_button_2 E_the_reset_button)
(declare-const the_reset_button_antes_2 E_the_reset_button_antes)
(declare-const the_overridden_mode_2 Bool)
(push)
(assert (not (= the_pressure_mode_antes_1 the_pressure_mode_antes__high)))
(assert (not (not (= the_pressure_mode_antes_2 the_pressure_mode_antes__high))))
(assert (= (= the_pressure_mode_1 the_pressure_mode__high) (= the_pressure_mode_2 the_pressure_mode__high)))
(assert (distinct (and (not (= the_pressure_mode_antes_1 the_pressure_mode_antes__high)) (= the_pressure_mode_1 the_pressure_mode__high)) (and (not (= the_pressure_mode_antes_2 the_pressure_mode_antes__high)) (= the_pressure_mode_2 the_pressure_mode__high))))
(check-sat)
(pop)
(push)
(assert (= the_pressure_mode_1 the_pressure_mode__high))
(assert (not (= the_pressure_mode_2 the_pressure_mode__high)))
(assert (= (not (= the_pressure_mode_antes_1 the_pressure_mode_antes__high)) (not (= the_pressure_mode_antes_2 the_pressure_mode_antes__high))))
(assert (distinct (and (not (= the_pressure_mode_antes_1 the_pressure_mode_antes__high)) (= the_pressure_mode_1 the_pressure_mode__high)) (and (not (= the_pressure_mode_antes_2 the_pressure_mode_antes__high)) (= the_pressure_mode_2 the_pressure_mode__high))))
(check-sat)
(pop)
