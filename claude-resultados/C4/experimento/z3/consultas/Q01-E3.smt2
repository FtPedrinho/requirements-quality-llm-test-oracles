; Q01-E3: avaliacao de cada combinacao de '(p and q) or (not p and r)'
(set-option :produce-models true)
(declare-const b0 Bool) ; p
(declare-const b1 Bool) ; q
(declare-const b2 Bool) ; r
(declare-const d Bool)
(assert (= d (or (and b0 b1) (and (not b0) b2))))
(push)
(assert (= b0 true))
(assert (= b1 true))
(assert (= b2 true))
(check-sat)
(get-value (d))
(pop)
