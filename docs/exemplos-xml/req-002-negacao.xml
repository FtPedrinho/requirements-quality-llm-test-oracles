<!-- FORMATO HIPOTÉTICO: substituir quando o XML real da ferramenta de origem estiver disponível. -->
<!-- Decisão: F1 AND NOT F2 -->
<requirement id="REQ-002">
  <text>Se a porta estiver fechada e o sensor não detectar obstáculo, o sistema deve liberar a partida.</text>
  <frames>
    <frame id="F1" type="condition">
      <subject>porta</subject>
      <state>fechada</state>
    </frame>
    <frame id="F2" type="condition">
      <subject>sensor</subject>
      <verb>detectar</verb>
      <object>obstáculo</object>
    </frame>
    <frame id="F3" type="action">
      <actor>sistema</actor>
      <verb>liberar</verb>
      <object>partida</object>
    </frame>
  </frames>
  <tree>
    <implies>
      <antecedent>
        <and>
          <ref frame="F1"/>
          <not>
            <ref frame="F2"/>
          </not>
        </and>
      </antecedent>
      <consequent>
        <ref frame="F3"/>
      </consequent>
    </implies>
  </tree>
</requirement>
