; Restricoes documentais de tabelas-verdade. Uma consulta por vetor.
(set-option :produce-models true)
; T01: A and B
(reset)
(set-option :produce-models true)
(declare-const A Bool)
(declare-const B Bool)
(declare-const decisao Bool)
(assert (= decisao (and A B)))
(push)
(assert (= A false))
(assert (= B false))
(check-sat)
(get-value (A B decisao))
(pop)
(push)
(assert (= A false))
(assert (= B true))
(check-sat)
(get-value (A B decisao))
(pop)
(push)
(assert (= A true))
(assert (= B false))
(check-sat)
(get-value (A B decisao))
(pop)
(push)
(assert (= A true))
(assert (= B true))
(check-sat)
(get-value (A B decisao))
(pop)
