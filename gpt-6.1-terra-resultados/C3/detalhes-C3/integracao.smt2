; F01: identificadores definidos no arquivo, com duas decisoes; tabelas em formulas.smt2.
(set-option :produce-models true)
(declare-const quantidade Int)
(declare-const primeira String)
(declare-const segunda String)
(assert (= quantidade 2))
(assert (= primeira "REQ-001"))
(assert (= segunda "REQ-002"))
(check-sat)
(get-value (quantidade primeira segunda))
(reset)
; F02: vinculo esperado entre a decisao e a origem. O SMT nao valida o parser.
(set-option :produce-models true)
(declare-const decisao String)
(declare-const requisito String)
(declare-const vinculados Bool)
(assert (= decisao "vm#1"))
(assert (= requisito "REQ-001"))
(assert vinculados)
(check-sat)
(get-value (decisao requisito vinculados))
(reset)
; F03: predicados sobre destinos de relatorio, nao sobre mensagens diagnosticas.
(set-option :produce-models true)
(declare-const relatorio-em-arquivo Bool)
(declare-const relatorio-na-tela Bool)
(assert relatorio-em-arquivo)
(assert (not relatorio-na-tela))
(check-sat)
(get-value (relatorio-em-arquivo relatorio-na-tela))
