; par de independencia para a condicao 2 de 'speed > 100 or (speed > 50 and rain)' (Int)
(declare-const s1 Int)(declare-const s2 Int)(declare-const rn1 Bool)(declare-const rn2 Bool)
(assert (not (= rn1 rn2)))
(assert (not (= (or (> s1 100) (and (> s1 50) rn1)) (or (> s2 100) (and (> s2 50) rn2)))))
(assert (not (= (or (> s1 100) (and (> s1 50) rn1)) (or (> s1 100) (and (> s1 50) (not rn1))))))
(assert (not (= (or (> s2 100) (and (> s2 50) rn2)) (or (> s2 100) (and (> s2 50) (not rn2))))))
(check-sat)
(get-model)
