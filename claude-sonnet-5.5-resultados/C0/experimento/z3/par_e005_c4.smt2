; par de independencia (mascaramento) para a aparicao 4 (B) de: (A and B and C) or (A and not B and not C) or (not A and B and not C) or (not A and not B and C)
(declare-const r1_A Bool)
(declare-const r1_B Bool)
(declare-const r1_C Bool)
(declare-const r2_A Bool)
(declare-const r2_B Bool)
(declare-const r2_C Bool)
(assert (not (= r1_B r2_B)))
(assert (not (= (or (or (or (and (and r1_A r1_B) r1_C) (and (and r1_A (not r1_B)) (not r1_C))) (and (and (not r1_A) r1_B) (not r1_C))) (and (and (not r1_A) (not r1_B)) r1_C)) (or (or (or (and (and r2_A r2_B) r2_C) (and (and r2_A (not r2_B)) (not r2_C))) (and (and (not r2_A) r2_B) (not r2_C))) (and (and (not r2_A) (not r2_B)) r2_C)))))
(assert (not (= (or (or (or (and (and r1_A r1_B) r1_C) (and (and r1_A (not r1_B)) (not r1_C))) (and (and (not r1_A) r1_B) (not r1_C))) (and (and (not r1_A) (not r1_B)) r1_C)) (or (or (or (and (and r1_A r1_B) r1_C) (and (and r1_A (not (not r1_B))) (not r1_C))) (and (and (not r1_A) r1_B) (not r1_C))) (and (and (not r1_A) (not r1_B)) r1_C)))))
(assert (not (= (or (or (or (and (and r2_A r2_B) r2_C) (and (and r2_A (not r2_B)) (not r2_C))) (and (and (not r2_A) r2_B) (not r2_C))) (and (and (not r2_A) (not r2_B)) r2_C)) (or (or (or (and (and r2_A r2_B) r2_C) (and (and r2_A (not (not r2_B))) (not r2_C))) (and (and (not r2_A) r2_B) (not r2_C))) (and (and (not r2_A) (not r2_B)) r2_C)))))
