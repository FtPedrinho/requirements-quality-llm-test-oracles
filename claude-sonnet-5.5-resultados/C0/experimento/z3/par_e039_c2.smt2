; par de independencia (mascaramento) para a aparicao 2 (C) de: A and (B or C)
(declare-const r1_A Bool)
(declare-const r1_B Bool)
(declare-const r1_C Bool)
(declare-const r2_A Bool)
(declare-const r2_B Bool)
(declare-const r2_C Bool)
(assert (not (= r1_C r2_C)))
(assert (not (= (and r1_A (or r1_B r1_C)) (and r2_A (or r2_B r2_C)))))
(assert (not (= (and r1_A (or r1_B r1_C)) (and r1_A (or r1_B (not r1_C))))))
(assert (not (= (and r2_A (or r2_B r2_C)) (and r2_A (or r2_B (not r2_C))))))
(check-sat)
(get-model)
