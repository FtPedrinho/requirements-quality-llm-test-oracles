; par de independencia (mascaramento) para a aparicao 0 (alarme_ativo) de: (alarme_ativo and porta_aberta) or botao_emergencia
(declare-const r1_alarme_ativo Bool)
(declare-const r1_botao_emergencia Bool)
(declare-const r1_porta_aberta Bool)
(declare-const r2_alarme_ativo Bool)
(declare-const r2_botao_emergencia Bool)
(declare-const r2_porta_aberta Bool)
(assert (not (= r1_alarme_ativo r2_alarme_ativo)))
(assert (not (= (or (and r1_alarme_ativo r1_porta_aberta) r1_botao_emergencia) (or (and r2_alarme_ativo r2_porta_aberta) r2_botao_emergencia))))
(assert (not (= (or (and r1_alarme_ativo r1_porta_aberta) r1_botao_emergencia) (or (and (not r1_alarme_ativo) r1_porta_aberta) r1_botao_emergencia))))
(assert (not (= (or (and r2_alarme_ativo r2_porta_aberta) r2_botao_emergencia) (or (and (not r2_alarme_ativo) r2_porta_aberta) r2_botao_emergencia))))
(check-sat)
(get-model)
