; par de independencia (mascaramento) para a aparicao 1 (B) de: (A and B) or (not A and C)
(declare-const r1_A Bool)
(declare-const r1_B Bool)
(declare-const r1_C Bool)
(declare-const r2_A Bool)
(declare-const r2_B Bool)
(declare-const r2_C Bool)
(assert (not (= r1_B r2_B)))
(assert (not (= (or (and r1_A r1_B) (and (not r1_A) r1_C)) (or (and r2_A r2_B) (and (not r2_A) r2_C)))))
(assert (not (= (or (and r1_A r1_B) (and (not r1_A) r1_C)) (or (and r1_A (not r1_B)) (and (not r1_A) r1_C)))))
(assert (not (= (or (and r2_A r2_B) (and (not r2_A) r2_C)) (or (and r2_A (not r2_B)) (and (not r2_A) r2_C)))))
(check-sat)
(get-model)
