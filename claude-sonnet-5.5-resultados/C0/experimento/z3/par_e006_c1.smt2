; par de independencia (mascaramento) para a aparicao 1 (D) de: ((E or D) and (not A or D)) or B
(declare-const r1_A Bool)
(declare-const r1_B Bool)
(declare-const r1_D Bool)
(declare-const r1_E Bool)
(declare-const r2_A Bool)
(declare-const r2_B Bool)
(declare-const r2_D Bool)
(declare-const r2_E Bool)
(assert (not (= r1_D r2_D)))
(assert (not (= (or (and (or r1_E r1_D) (or (not r1_A) r1_D)) r1_B) (or (and (or r2_E r2_D) (or (not r2_A) r2_D)) r2_B))))
(assert (not (= (or (and (or r1_E r1_D) (or (not r1_A) r1_D)) r1_B) (or (and (or r1_E (not r1_D)) (or (not r1_A) r1_D)) r1_B))))
(assert (not (= (or (and (or r2_E r2_D) (or (not r2_A) r2_D)) r2_B) (or (and (or r2_E (not r2_D)) (or (not r2_A) r2_D)) r2_B))))
(check-sat)
(get-model)
