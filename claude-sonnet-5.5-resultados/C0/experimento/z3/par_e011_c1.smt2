; par de independencia (mascaramento) para a aparicao 1 (B) de: A or B and C
(declare-const r1_A Bool)
(declare-const r1_B Bool)
(declare-const r1_C Bool)
(declare-const r2_A Bool)
(declare-const r2_B Bool)
(declare-const r2_C Bool)
(assert (or (not r1_A) (not r1_C)))
(assert (or (not r2_A) (not r2_C)))
(assert (not (= r1_B r2_B)))
(assert (not (= (or r1_A (and r1_B r1_C)) (or r2_A (and r2_B r2_C)))))
(assert (not (= (or r1_A (and r1_B r1_C)) (or r1_A (and (not r1_B) r1_C)))))
(assert (not (= (or r2_A (and r2_B r2_C)) (or r2_A (and (not r2_B) r2_C)))))
(check-sat)
(get-model)
