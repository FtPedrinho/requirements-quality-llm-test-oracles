; par de independencia (mascaramento) para a aparicao 2 (B) de: A or (A and B)
(declare-const r1_A Bool)
(declare-const r1_B Bool)
(declare-const r2_A Bool)
(declare-const r2_B Bool)
(assert (not (= r1_B r2_B)))
(assert (not (= (or r1_A (and r1_A r1_B)) (or r2_A (and r2_A r2_B)))))
(assert (not (= (or r1_A (and r1_A r1_B)) (or r1_A (and r1_A (not r1_B))))))
(assert (not (= (or r2_A (and r2_A r2_B)) (or r2_A (and r2_A (not r2_B))))))
(check-sat)
(get-model)
