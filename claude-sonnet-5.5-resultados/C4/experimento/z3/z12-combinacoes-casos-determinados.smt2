; Contagens combinatorias usadas nos casos DETERMINADOS (2^n sobre entradas distintas; linha 79).
(set-logic ALL)

(echo "D22 speed>100 /\ mode=idle: 2 entradas -> 4")
(push)
(declare-const n Int)(declare-const c Int)(assert (= n 2))
(assert (= c (* 2 2)))
(assert (= c 4))
(check-sat)
(pop)

(echo "D23 B or (C and D): 3 entradas -> 8")
(push)
(declare-const n Int)(declare-const c Int)(assert (= n 3))
(assert (= c (* 2 2 2)))
(assert (= c 8))
(check-sat)
(pop)

(echo "D24 B or (not B and C): 2 entradas distintas -> 4")
(push)
(declare-const n Int)(declare-const c Int)(assert (= n 2))
(assert (= c (* 2 2)))
(assert (= c 4))
(check-sat)
(pop)

(echo "D26 20 entradas -> 1048576")
(push)
(declare-const n Int)(declare-const c Int)(assert (= n 20))
(assert (= c (* 2 2 2 2 2 2 2 2 2 2 2 2 2 2 2 2 2 2 2 2)))
(assert (= c 1048576))
(check-sat)
(pop)

(echo "D29 paridade de 3 entradas -> 8 combinacoes (= 8 testes)")
(push)
(declare-const n Int)(declare-const c Int)(assert (= n 3))
(assert (= c (* 2 2 2)))
(assert (= c 8))
(check-sat)
(pop)

(echo "D26 contra-prova: 2^20 diferente de 1000000 exato, mas na faixa de cerca de 1 milhao (1e6 a 1,1e6)")
(push)(declare-const c Int)(assert (= c 1048576))(assert (>= c 1000000))(assert (<= c 1100000))(check-sat)(pop)
