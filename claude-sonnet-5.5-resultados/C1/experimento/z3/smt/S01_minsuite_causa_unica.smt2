(set-logic ALL)
(define-fun f ((A Bool) (B Bool)) Bool (and A (not B)))
(declare-const s0 Bool)
(declare-const s1 Bool)
(declare-const s2 Bool)
(declare-const s3 Bool)
(assert (or false (and s0 s2 (not (= (f true true) (f false true)))) (and s1 s3 (not (= (f true false) (f false false))))))
(assert (or false (and s0 s1 (not (= (f true true) (f true false)))) (and s2 s3 (not (= (f false true) (f false false))))))
(minimize (+ (ite s0 1 0) (ite s1 1 0) (ite s2 1 0) (ite s3 1 0)))
(check-sat)
(get-objectives)
