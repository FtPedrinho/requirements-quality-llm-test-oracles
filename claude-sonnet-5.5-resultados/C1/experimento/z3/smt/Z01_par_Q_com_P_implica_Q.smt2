(set-logic ALL)
(define-fun f ((P Bool) (Q Bool) (R Bool)) Bool (or P (and Q R)))
(declare-const x0 Bool)
(declare-const y0 Bool)
(declare-const x1 Bool)
(declare-const y1 Bool)
(declare-const x2 Bool)
(declare-const y2 Bool)
(assert (=> x0 x1))(assert (=> y0 y1))
(assert (= x0 y0))
(assert (not (= x1 y1)))
(assert (= x2 y2))
(assert (not (= (f x0 x1 x2) (f y0 y1 y2))))
(check-sat)
(get-model)
