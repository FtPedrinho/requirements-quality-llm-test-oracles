(set-logic ALL)
(define-fun f ((A Bool) (B Bool)) Bool (and A B))
(push)
(assert (or false (not (= (f true true) (f false true)))))
(echo "entrada A: par existe?")
(check-sat)
(pop)
(push)
(assert (or false (not (= (f true true) (f true false)))))
(echo "entrada B: par existe?")
(check-sat)
(pop)
(check-sat)
(echo "T1: valor calculado de f abaixo; esperado=true")
(get-value ((f true true)))
(echo "T2: valor calculado de f abaixo; esperado=false")
(get-value ((f false true)))
(echo "T3: valor calculado de f abaixo; esperado=false")
(get-value ((f true false)))
