(set-logic QF_UF)
(define-fun f ((A Bool) (B Bool)) Bool (and A (not B)))
(declare-const A_0 Bool)
(declare-const B_0 Bool)
(declare-const A_1 Bool)
(declare-const B_1 Bool)
(declare-const A_2 Bool)
(declare-const B_2 Bool)
(assert (or (and (not (= A_0 A_1)) (= B_0 B_1) (not (= (f A_0 B_0) (f A_1 B_1)))) (and (not (= A_0 A_2)) (= B_0 B_2) (not (= (f A_0 B_0) (f A_2 B_2)))) (and (not (= A_1 A_0)) (= B_1 B_0) (not (= (f A_1 B_1) (f A_0 B_0)))) (and (not (= A_1 A_2)) (= B_1 B_2) (not (= (f A_1 B_1) (f A_2 B_2)))) (and (not (= A_2 A_0)) (= B_2 B_0) (not (= (f A_2 B_2) (f A_0 B_0)))) (and (not (= A_2 A_1)) (= B_2 B_1) (not (= (f A_2 B_2) (f A_1 B_1))))))
(assert (or (and (not (= B_0 B_1)) (= A_0 A_1) (not (= (f A_0 B_0) (f A_1 B_1)))) (and (not (= B_0 B_2)) (= A_0 A_2) (not (= (f A_0 B_0) (f A_2 B_2)))) (and (not (= B_1 B_0)) (= A_1 A_0) (not (= (f A_1 B_1) (f A_0 B_0)))) (and (not (= B_1 B_2)) (= A_1 A_2) (not (= (f A_1 B_1) (f A_2 B_2)))) (and (not (= B_2 B_0)) (= A_2 A_0) (not (= (f A_2 B_2) (f A_0 B_0)))) (and (not (= B_2 B_1)) (= A_2 A_1) (not (= (f A_2 B_2) (f A_1 B_1))))))
(check-sat)
(get-model)
