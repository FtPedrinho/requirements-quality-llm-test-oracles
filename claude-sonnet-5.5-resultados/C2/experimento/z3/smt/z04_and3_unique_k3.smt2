(set-logic QF_UF)
(define-fun f ((A Bool) (B Bool) (C Bool)) Bool (and A B C))
(declare-const A_0 Bool)
(declare-const B_0 Bool)
(declare-const C_0 Bool)
(declare-const A_1 Bool)
(declare-const B_1 Bool)
(declare-const C_1 Bool)
(declare-const A_2 Bool)
(declare-const B_2 Bool)
(declare-const C_2 Bool)
(assert (or (and (not (= A_0 A_1)) (= B_0 B_1) (= C_0 C_1) (not (= (f A_0 B_0 C_0) (f A_1 B_1 C_1)))) (and (not (= A_0 A_2)) (= B_0 B_2) (= C_0 C_2) (not (= (f A_0 B_0 C_0) (f A_2 B_2 C_2)))) (and (not (= A_1 A_0)) (= B_1 B_0) (= C_1 C_0) (not (= (f A_1 B_1 C_1) (f A_0 B_0 C_0)))) (and (not (= A_1 A_2)) (= B_1 B_2) (= C_1 C_2) (not (= (f A_1 B_1 C_1) (f A_2 B_2 C_2)))) (and (not (= A_2 A_0)) (= B_2 B_0) (= C_2 C_0) (not (= (f A_2 B_2 C_2) (f A_0 B_0 C_0)))) (and (not (= A_2 A_1)) (= B_2 B_1) (= C_2 C_1) (not (= (f A_2 B_2 C_2) (f A_1 B_1 C_1))))))
(assert (or (and (not (= B_0 B_1)) (= A_0 A_1) (= C_0 C_1) (not (= (f A_0 B_0 C_0) (f A_1 B_1 C_1)))) (and (not (= B_0 B_2)) (= A_0 A_2) (= C_0 C_2) (not (= (f A_0 B_0 C_0) (f A_2 B_2 C_2)))) (and (not (= B_1 B_0)) (= A_1 A_0) (= C_1 C_0) (not (= (f A_1 B_1 C_1) (f A_0 B_0 C_0)))) (and (not (= B_1 B_2)) (= A_1 A_2) (= C_1 C_2) (not (= (f A_1 B_1 C_1) (f A_2 B_2 C_2)))) (and (not (= B_2 B_0)) (= A_2 A_0) (= C_2 C_0) (not (= (f A_2 B_2 C_2) (f A_0 B_0 C_0)))) (and (not (= B_2 B_1)) (= A_2 A_1) (= C_2 C_1) (not (= (f A_2 B_2 C_2) (f A_1 B_1 C_1))))))
(assert (or (and (not (= C_0 C_1)) (= A_0 A_1) (= B_0 B_1) (not (= (f A_0 B_0 C_0) (f A_1 B_1 C_1)))) (and (not (= C_0 C_2)) (= A_0 A_2) (= B_0 B_2) (not (= (f A_0 B_0 C_0) (f A_2 B_2 C_2)))) (and (not (= C_1 C_0)) (= A_1 A_0) (= B_1 B_0) (not (= (f A_1 B_1 C_1) (f A_0 B_0 C_0)))) (and (not (= C_1 C_2)) (= A_1 A_2) (= B_1 B_2) (not (= (f A_1 B_1 C_1) (f A_2 B_2 C_2)))) (and (not (= C_2 C_0)) (= A_2 A_0) (= B_2 B_0) (not (= (f A_2 B_2 C_2) (f A_0 B_0 C_0)))) (and (not (= C_2 C_1)) (= A_2 A_1) (= B_2 B_1) (not (= (f A_2 B_2 C_2) (f A_1 B_1 C_1))))))
(check-sat)
