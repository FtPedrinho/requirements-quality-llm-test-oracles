(set-logic QF_UF)
(declare-const A Bool)(declare-const B Bool)
(define-fun f ((A Bool)(B Bool)) Bool (and A B))
(define-fun ok ((A Bool)(B Bool)) Bool (not (and A B)))
(assert (ok A B))(assert (ok (not A) B))(assert (not (= (f A B) (f (not A) B))))
(check-sat)
(reset)
(declare-const A Bool)(declare-const B Bool)
(define-fun f ((A Bool)(B Bool)) Bool (and A B))
(assert (f A B))
(check-sat)
