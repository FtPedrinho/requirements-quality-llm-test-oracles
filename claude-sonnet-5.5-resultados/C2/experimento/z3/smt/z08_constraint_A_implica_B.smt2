(set-logic QF_UF)
(declare-const A Bool)(declare-const B Bool)(declare-const C Bool)
(push 1)(assert (= A true))(assert (= B true))(assert (= C true))(assert (or (not A) B))(echo "linha 0: A=true B=true C=true")(check-sat)(pop 1)
(push 1)(assert (= A true))(assert (= B true))(assert (= C false))(assert (or (not A) B))(echo "linha 1: A=true B=true C=false")(check-sat)(pop 1)
(push 1)(assert (= A true))(assert (= B false))(assert (= C true))(assert (or (not A) B))(echo "linha 2: A=true B=false C=true")(check-sat)(pop 1)
(push 1)(assert (= A true))(assert (= B false))(assert (= C false))(assert (or (not A) B))(echo "linha 3: A=true B=false C=false")(check-sat)(pop 1)
(push 1)(assert (= A false))(assert (= B true))(assert (= C true))(assert (or (not A) B))(echo "linha 4: A=false B=true C=true")(check-sat)(pop 1)
(push 1)(assert (= A false))(assert (= B true))(assert (= C false))(assert (or (not A) B))(echo "linha 5: A=false B=true C=false")(check-sat)(pop 1)
(push 1)(assert (= A false))(assert (= B false))(assert (= C true))(assert (or (not A) B))(echo "linha 6: A=false B=false C=true")(check-sat)(pop 1)
(push 1)(assert (= A false))(assert (= B false))(assert (= C false))(assert (or (not A) B))(echo "linha 7: A=false B=false C=false")(check-sat)(pop 1)
