(set-logic QF_UF)
(define-fun f ((A Bool) (B Bool) (C Bool) (D Bool)) Bool (and (or A B) (or C D)))
(declare-const A_0 Bool)
(declare-const B_0 Bool)
(declare-const C_0 Bool)
(declare-const D_0 Bool)
(declare-const A_1 Bool)
(declare-const B_1 Bool)
(declare-const C_1 Bool)
(declare-const D_1 Bool)
(assert (or (and (not (= A_0 A_1)) (not (= (f A_0 B_0 C_0 D_0) (f A_1 B_1 C_1 D_1))) (not (= (f A_0 B_0 C_0 D_0) (f (not A_0) B_0 C_0 D_0))) (not (= (f A_1 B_1 C_1 D_1) (f (not A_1) B_1 C_1 D_1)))) (and (not (= A_1 A_0)) (not (= (f A_1 B_1 C_1 D_1) (f A_0 B_0 C_0 D_0))) (not (= (f A_1 B_1 C_1 D_1) (f (not A_1) B_1 C_1 D_1))) (not (= (f A_0 B_0 C_0 D_0) (f (not A_0) B_0 C_0 D_0))))))
(assert (or (and (not (= B_0 B_1)) (not (= (f A_0 B_0 C_0 D_0) (f A_1 B_1 C_1 D_1))) (not (= (f A_0 B_0 C_0 D_0) (f A_0 (not B_0) C_0 D_0))) (not (= (f A_1 B_1 C_1 D_1) (f A_1 (not B_1) C_1 D_1)))) (and (not (= B_1 B_0)) (not (= (f A_1 B_1 C_1 D_1) (f A_0 B_0 C_0 D_0))) (not (= (f A_1 B_1 C_1 D_1) (f A_1 (not B_1) C_1 D_1))) (not (= (f A_0 B_0 C_0 D_0) (f A_0 (not B_0) C_0 D_0))))))
(assert (or (and (not (= C_0 C_1)) (not (= (f A_0 B_0 C_0 D_0) (f A_1 B_1 C_1 D_1))) (not (= (f A_0 B_0 C_0 D_0) (f A_0 B_0 (not C_0) D_0))) (not (= (f A_1 B_1 C_1 D_1) (f A_1 B_1 (not C_1) D_1)))) (and (not (= C_1 C_0)) (not (= (f A_1 B_1 C_1 D_1) (f A_0 B_0 C_0 D_0))) (not (= (f A_1 B_1 C_1 D_1) (f A_1 B_1 (not C_1) D_1))) (not (= (f A_0 B_0 C_0 D_0) (f A_0 B_0 (not C_0) D_0))))))
(assert (or (and (not (= D_0 D_1)) (not (= (f A_0 B_0 C_0 D_0) (f A_1 B_1 C_1 D_1))) (not (= (f A_0 B_0 C_0 D_0) (f A_0 B_0 C_0 (not D_0)))) (not (= (f A_1 B_1 C_1 D_1) (f A_1 B_1 C_1 (not D_1))))) (and (not (= D_1 D_0)) (not (= (f A_1 B_1 C_1 D_1) (f A_0 B_0 C_0 D_0))) (not (= (f A_1 B_1 C_1 D_1) (f A_1 B_1 C_1 (not D_1)))) (not (= (f A_0 B_0 C_0 D_0) (f A_0 B_0 C_0 (not D_0)))))))
(check-sat)
