#!/usr/bin/env bash
# Roda a ferramenta a partir das classes compiladas. Compile antes com: mvn -q compile
DIR="$(cd "$(dirname "$0")" && pwd)"
JAVA="${JAVA_HOME:+$JAVA_HOME/bin/}java"
DEPS="$DIR/mcdc-cli/target/classpath.txt"
if [ ! -f "$DEPS" ]; then
  echo "Classes não encontradas. Compile antes com: mvn -q compile" >&2
  exit 1
fi
exec "$JAVA" -cp "$DIR/mcdc-cli/target/classes:$(cat "$DEPS")" io.github.rvdomingos.mcdc.cli.Main "$@"
