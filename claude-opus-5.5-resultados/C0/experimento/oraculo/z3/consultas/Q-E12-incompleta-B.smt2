(declare-const T1_A Bool)
(declare-const T1_B Bool)
(declare-const T1_C Bool)
(assert (and T1_A T1_B (not T1_C)))
(declare-const T2_A Bool)
(declare-const T2_B Bool)
(declare-const T2_C Bool)
(assert (and (not T2_A) T2_B (not T2_C)))
(assert (or (and (distinct T1_B T2_B) (distinct (or (and T1_A T1_B) T1_C) (or (and T2_A T2_B) T2_C)) (distinct (or (and T1_A T1_B) T1_C) (or (and T1_A (not T1_B)) T1_C)) (distinct (or (and T2_A T2_B) T2_C) (or (and T2_A (not T2_B)) T2_C)))))
(check-sat)
