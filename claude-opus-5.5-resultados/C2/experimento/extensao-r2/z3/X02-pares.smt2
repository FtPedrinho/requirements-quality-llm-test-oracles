; consulta X02-pares -- X02
(set-logic ALL)
(declare-datatypes () ((E_m m__idle m__outro_valor)))
(declare-const m_1 E_m)
(declare-const n_1 Int)
(declare-const m_2 E_m)
(declare-const n_2 Int)
(push)
(assert (not (= m_1 m__idle)))
(assert (not (not (= m_2 m__idle))))
(assert (= (= n_1 4) (= n_2 4)))
(assert (distinct (and (not (= m_1 m__idle)) (= n_1 4)) (and (not (= m_2 m__idle)) (= n_2 4))))
(check-sat)
(pop)
(push)
(assert (= n_1 4))
(assert (not (= n_2 4)))
(assert (= (not (= m_1 m__idle)) (not (= m_2 m__idle))))
(assert (distinct (and (not (= m_1 m__idle)) (= n_1 4)) (and (not (= m_2 m__idle)) (= n_2 4))))
(check-sat)
(pop)
