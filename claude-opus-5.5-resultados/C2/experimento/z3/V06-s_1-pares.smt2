; consulta V06-s_1-pares -- par de causa única viável por entrada de s#1
(set-logic ALL)
(declare-datatypes () ((E_mode mode__idle mode__busy)))
(declare-const mode_1 E_mode)
(declare-const s_1 Bool)
(declare-const mode_2 E_mode)
(declare-const s_2 Bool)
(push)
(assert (= mode_1 mode__idle))
(assert (not (= mode_2 mode__idle)))
(assert (= (= s_1 true) (= s_2 true)))
(assert (distinct (and (= mode_1 mode__idle) (= s_1 true)) (and (= mode_2 mode__idle) (= s_2 true))))
(check-sat)
(pop)
(push)
(assert (= s_1 true))
(assert (not (= s_2 true)))
(assert (= (= mode_1 mode__idle) (= mode_2 mode__idle)))
(assert (distinct (and (= mode_1 mode__idle) (= s_1 true)) (and (= mode_2 mode__idle) (= s_2 true))))
(check-sat)
(pop)
