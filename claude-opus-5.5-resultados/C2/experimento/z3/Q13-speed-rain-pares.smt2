; consulta Q13-speed-rain-pares -- A27
(set-logic ALL)
(declare-const speed_1 Int)
(declare-const rain_1 Bool)
(declare-const speed_2 Int)
(declare-const rain_2 Bool)
(push)
(assert (> speed_1 100))
(assert (not (> speed_2 100)))
(assert (= (> speed_1 50) (> speed_2 50)))
(assert (= rain_1 rain_2))
(assert (distinct (or (> speed_1 100) (and (> speed_1 50) rain_1)) (or (> speed_2 100) (and (> speed_2 50) rain_2))))
(check-sat)
(pop)
