; consulta Q25-check-AandB-pares -- C02-C04: pares de causa única de A and B
(set-logic ALL)
(declare-const A_1 Bool)
(declare-const B_1 Bool)
(declare-const A_2 Bool)
(declare-const B_2 Bool)
(push)
(assert A_1)
(assert (not A_2))
(assert (= B_1 B_2))
(assert (distinct (and A_1 B_1) (and A_2 B_2)))
(check-sat)
(pop)
(push)
(assert B_1)
(assert (not B_2))
(assert (= A_1 A_2))
(assert (distinct (and A_1 B_1) (and A_2 B_2)))
(check-sat)
(pop)
