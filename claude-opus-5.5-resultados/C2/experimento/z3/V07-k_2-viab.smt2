; consulta V07-k_2-viab -- viabilidade das combinações de k#2
(set-logic ALL)
(declare-datatypes () ((E_mode mode__idle mode__busy)))
(declare-const mode E_mode)
(declare-const s Bool)
(push)
(assert (= mode mode__idle))
(assert (= s false))
(check-sat)
(pop)
(push)
(assert (= mode mode__idle))
(assert (not (= s false)))
(check-sat)
(pop)
(push)
(assert (not (= mode mode__idle)))
(assert (= s false))
(check-sat)
(pop)
(push)
(assert (not (= mode mode__idle)))
(assert (not (= s false)))
(check-sat)
(pop)
