; consulta Q14-fronteira-gt100 -- A28: menor valor que satisfaz e maior que não satisfaz speed > 100 (inteiros)
(set-logic ALL)
(declare-const x Int)
(declare-const y Int)
(push)
(assert (> x 100))
(assert (not (> (- x 1) 100)))
(check-sat)
(get-value (x))
(assert (distinct x 101))
(check-sat)
(pop)
(push)
(assert (not (> y 100)))
(assert (> (+ y 1) 100))
(check-sat)
(get-value (y))
(assert (distinct y 100))
(check-sat)
(pop)
