; consulta V05-c_2-pares -- par de causa única viável por entrada de c#2
(set-logic ALL)
(declare-const x_1 Int)
(declare-const s_1 Bool)
(declare-const x_2 Int)
(declare-const s_2 Bool)
(push)
(assert (> x_1 3))
(assert (not (> x_2 3)))
(assert (= (= s_1 true) (= s_2 true)))
(assert (distinct (and (> x_1 3) (= s_1 true)) (and (> x_2 3) (= s_2 true))))
(check-sat)
(pop)
(push)
(assert (= s_1 true))
(assert (not (= s_2 true)))
(assert (= (> x_1 3) (> x_2 3)))
(assert (distinct (and (> x_1 3) (= s_1 true)) (and (> x_2 3) (= s_2 true))))
(check-sat)
(pop)
