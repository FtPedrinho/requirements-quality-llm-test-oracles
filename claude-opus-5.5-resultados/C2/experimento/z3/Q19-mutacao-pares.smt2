; consulta Q19-mutacao-pares -- A36
(set-logic ALL)
(declare-const A_1 Bool)
(declare-const B_1 Bool)
(declare-const C_1 Bool)
(declare-const A_2 Bool)
(declare-const B_2 Bool)
(declare-const C_2 Bool)
(push)
(assert A_1)
(assert (not A_2))
(assert (= B_1 B_2))
(assert (= C_1 C_2))
(assert (distinct (and A_1 (or B_1 C_1)) (and A_2 (or B_2 C_2))))
(check-sat)
(pop)
(push)
(assert B_1)
(assert (not B_2))
(assert (= A_1 A_2))
(assert (= C_1 C_2))
(assert (distinct (and A_1 (or B_1 C_1)) (and A_2 (or B_2 C_2))))
(check-sat)
(pop)
(push)
(assert C_1)
(assert (not C_2))
(assert (= A_1 A_2))
(assert (= B_1 B_2))
(assert (distinct (and A_1 (or B_1 C_1)) (and A_2 (or B_2 C_2))))
(check-sat)
(pop)
