; consulta Q03-speed-mode-pares -- A06 (forma 'and' equivalente a /\)
(set-logic ALL)
(declare-datatypes () ((E_mode mode__idle mode__outro_valor)))
(declare-const speed_1 Int)
(declare-const mode_1 E_mode)
(declare-const speed_2 Int)
(declare-const mode_2 E_mode)
(push)
(assert (> speed_1 100))
(assert (not (> speed_2 100)))
(assert (= (= mode_1 mode__idle) (= mode_2 mode__idle)))
(assert (distinct (and (> speed_1 100) (= mode_1 mode__idle)) (and (> speed_2 100) (= mode_2 mode__idle))))
(check-sat)
(pop)
(push)
(assert (= mode_1 mode__idle))
(assert (not (= mode_2 mode__idle)))
(assert (= (> speed_1 100) (> speed_2 100)))
(assert (distinct (and (> speed_1 100) (= mode_1 mode__idle)) (and (> speed_2 100) (= mode_2 mode__idle))))
(check-sat)
(pop)
