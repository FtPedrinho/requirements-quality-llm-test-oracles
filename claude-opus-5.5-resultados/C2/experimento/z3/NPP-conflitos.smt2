; consulta NPP-conflitos -- sobreposição de guardas com ações de valores diferentes
(set-logic ALL)
(declare-datatypes () ((E_the_pressure_mode the_pressure_mode__low the_pressure_mode__permitted the_pressure_mode__high)))
(declare-datatypes () ((E_the_pressure_mode_antes the_pressure_mode_antes__low the_pressure_mode_antes__permitted the_pressure_mode_antes__high)))
(declare-datatypes () ((E_the_blockage_button the_blockage_button__released the_blockage_button__pressed)))
(declare-datatypes () ((E_the_blockage_button_antes the_blockage_button_antes__released the_blockage_button_antes__pressed)))
(declare-datatypes () ((E_the_reset_button the_reset_button__released the_reset_button__pressed)))
(declare-datatypes () ((E_the_reset_button_antes the_reset_button_antes__released the_reset_button_antes__pressed)))
(declare-const the_water_pressure Int)
(declare-const the_water_pressure_antes Int)
(declare-const the_pressure_mode E_the_pressure_mode)
(declare-const the_pressure_mode_antes E_the_pressure_mode_antes)
(declare-const the_blockage_button E_the_blockage_button)
(declare-const the_blockage_button_antes E_the_blockage_button_antes)
(declare-const the_reset_button E_the_reset_button)
(declare-const the_reset_button_antes E_the_reset_button_antes)
(declare-const the_overridden_mode Bool)
(push)
(assert (and (< the_water_pressure_antes 9) (>= the_water_pressure 9) (= the_pressure_mode the_pressure_mode__low)))
(assert (and (< the_water_pressure_antes 10) (>= the_water_pressure 10) (= the_pressure_mode the_pressure_mode__permitted)))
(check-sat)
(pop)
(push)
(assert (and (< the_water_pressure_antes 9) (>= the_water_pressure 9) (= the_pressure_mode the_pressure_mode__low)))
(assert (and (>= the_water_pressure_antes 9) (< the_water_pressure 9) (= the_pressure_mode the_pressure_mode__permitted)))
(check-sat)
(pop)
(push)
(assert (and (< the_water_pressure_antes 10) (>= the_water_pressure 10) (= the_pressure_mode the_pressure_mode__permitted)))
(assert (and (>= the_water_pressure_antes 9) (< the_water_pressure 9) (= the_pressure_mode the_pressure_mode__permitted)))
(check-sat)
(pop)
(push)
(assert (and (< the_water_pressure_antes 10) (>= the_water_pressure 10) (= the_pressure_mode the_pressure_mode__permitted)))
(assert (and (>= the_water_pressure_antes 10) (< the_water_pressure 10) (= the_pressure_mode the_pressure_mode__high)))
(check-sat)
(pop)
(push)
(assert (and (>= the_water_pressure_antes 9) (< the_water_pressure 9) (= the_pressure_mode the_pressure_mode__permitted)))
(assert (and (>= the_water_pressure_antes 10) (< the_water_pressure 10) (= the_pressure_mode the_pressure_mode__high)))
(check-sat)
(pop)
(push)
(assert (and (not (= the_blockage_button_antes the_blockage_button_antes__pressed)) (= the_blockage_button the_blockage_button__pressed) (not (= the_reset_button the_reset_button__pressed)) (not (= the_pressure_mode the_pressure_mode__high))))
(assert (and (not (= the_reset_button_antes the_reset_button_antes__pressed)) (= the_reset_button the_reset_button__pressed) (not (= the_pressure_mode the_pressure_mode__high))))
(check-sat)
(pop)
(push)
(assert (and (not (= the_blockage_button_antes the_blockage_button_antes__pressed)) (= the_blockage_button the_blockage_button__pressed) (not (= the_reset_button the_reset_button__pressed)) (not (= the_pressure_mode the_pressure_mode__high))))
(assert (and (not (= the_pressure_mode_antes the_pressure_mode_antes__high)) (= the_pressure_mode the_pressure_mode__high)))
(check-sat)
(pop)
(push)
(assert (and (not (= the_blockage_button_antes the_blockage_button_antes__pressed)) (= the_blockage_button the_blockage_button__pressed) (not (= the_reset_button the_reset_button__pressed)) (not (= the_pressure_mode the_pressure_mode__high))))
(assert (and (= the_pressure_mode_antes the_pressure_mode_antes__high) (not (= the_pressure_mode the_pressure_mode__high))))
(check-sat)
(pop)
(push)
(assert (and (= the_pressure_mode the_pressure_mode__low) (= the_overridden_mode true)))
(assert (and (= the_pressure_mode the_pressure_mode__low) (= the_overridden_mode false)))
(check-sat)
(pop)
(push)
(assert (and (= the_pressure_mode the_pressure_mode__low) (= the_overridden_mode false)))
(assert (or (= the_pressure_mode the_pressure_mode__permitted) (= the_pressure_mode the_pressure_mode__high)))
(check-sat)
(pop)
