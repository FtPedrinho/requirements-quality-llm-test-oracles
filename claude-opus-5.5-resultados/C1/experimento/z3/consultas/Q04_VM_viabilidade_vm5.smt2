; VM vm5: viabilidade de cada uma das 2^3 combinações (uma check-sat por linha)

(declare-datatypes () ((Mode idle choice preparing_weak preparing_strong)))
(declare-datatypes () ((Btn released pressed)))
(declare-const the_system_mode Mode)
(declare-const the_coin_sensor Bool)
(declare-const the_coin_sensor_antes Bool)
(declare-const the_coffee_request_button Btn)
(declare-const the_coffee_request_button_antes Btn)
(declare-const the_request_timer Real)

(push)
(echo "linha TTT")
(assert (= the_system_mode preparing_strong))
(assert (>= the_request_timer 30.0))
(assert (<= the_request_timer 50.0))
(check-sat)
(pop)
(push)
(echo "linha TTF")
(assert (= the_system_mode preparing_strong))
(assert (>= the_request_timer 30.0))
(assert (not (<= the_request_timer 50.0)))
(check-sat)
(pop)
(push)
(echo "linha TFT")
(assert (= the_system_mode preparing_strong))
(assert (not (>= the_request_timer 30.0)))
(assert (<= the_request_timer 50.0))
(check-sat)
(pop)
(push)
(echo "linha TFF")
(assert (= the_system_mode preparing_strong))
(assert (not (>= the_request_timer 30.0)))
(assert (not (<= the_request_timer 50.0)))
(check-sat)
(pop)
(push)
(echo "linha FTT")
(assert (not (= the_system_mode preparing_strong)))
(assert (>= the_request_timer 30.0))
(assert (<= the_request_timer 50.0))
(check-sat)
(pop)
(push)
(echo "linha FTF")
(assert (not (= the_system_mode preparing_strong)))
(assert (>= the_request_timer 30.0))
(assert (not (<= the_request_timer 50.0)))
(check-sat)
(pop)
(push)
(echo "linha FFT")
(assert (not (= the_system_mode preparing_strong)))
(assert (not (>= the_request_timer 30.0)))
(assert (<= the_request_timer 50.0))
(check-sat)
(pop)
(push)
(echo "linha FFF")
(assert (not (= the_system_mode preparing_strong)))
(assert (not (>= the_request_timer 30.0)))
(assert (not (<= the_request_timer 50.0)))
(check-sat)
(pop)
