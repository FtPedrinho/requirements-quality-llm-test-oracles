; Q01-E2: avaliacao de cada combinacao de 'x or y'
(set-option :produce-models true)
(declare-const b0 Bool) ; x
(declare-const b1 Bool) ; y
(declare-const d Bool)
(assert (= d (or b0 b1)))
(push)
(assert (= b0 true))
(assert (= b1 true))
(check-sat)
(get-value (d))
(pop)
(push)
(assert (= b0 true))
(assert (= b1 false))
(check-sat)
(get-value (d))
(pop)
(push)
(assert (= b0 false))
(assert (= b1 true))
(check-sat)
(get-value (d))
(pop)
(push)
(assert (= b0 false))
(assert (= b1 false))
(check-sat)
(get-value (d))
(pop)
