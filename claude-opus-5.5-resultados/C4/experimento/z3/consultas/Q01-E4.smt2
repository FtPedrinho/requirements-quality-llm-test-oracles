; Q01-E4: avaliacao de cada combinacao de 'p or (q and r)'
(set-option :produce-models true)
(declare-const b0 Bool) ; p
(declare-const b1 Bool) ; q
(declare-const b2 Bool) ; r
(declare-const d Bool)
(assert (= d (or b0 (and b1 b2))))
(push)
(assert (= b0 true))
(assert (= b1 true))
(assert (= b2 true))
(check-sat)
(get-value (d))
(pop)
