; Q06: 20 entradas -> 2^20 combinacoes; pares de causa unica de x01 em E5 > 1000
(declare-const combinacoes Int)
(declare-const pares_x01 Int)
(assert (= combinacoes (^ 2 20)))
(assert (= pares_x01 (- (^ 2 19) 1)))
(push)
(assert (= combinacoes 1048576))
(assert (> pares_x01 1000))
(check-sat)
(pop)
(push)
(assert (<= pares_x01 1000))
(check-sat)
(pop)
