; viabilidade das combinações de (speed > 100, speed > 50, rain)
(declare-const speed Int)
(declare-const rain Bool)
(push)(assert (and (> speed 100) (> speed 50) (= rain true)))(check-sat)(pop)
(push)(assert (and (> speed 100) (> speed 50) (= rain false)))(check-sat)(pop)
(push)(assert (and (> speed 100) (not (> speed 50)) (= rain true)))(check-sat)(pop)
(push)(assert (and (> speed 100) (not (> speed 50)) (= rain false)))(check-sat)(pop)
(push)(assert (and (not (> speed 100)) (> speed 50) (= rain true)))(check-sat)(pop)
(push)(assert (and (not (> speed 100)) (> speed 50) (= rain false)))(check-sat)(pop)
(push)(assert (and (not (> speed 100)) (not (> speed 50)) (= rain true)))(check-sat)(pop)
(push)(assert (and (not (> speed 100)) (not (> speed 50)) (= rain false)))(check-sat)(pop)
